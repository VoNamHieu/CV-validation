{
  "name": "copo-extension",
  "private": true,
  "version": "2.8.0",
  "description": "Copo \u2014 Auto Apply extension. Source in src/ (ES modules), bundled to dist/ with esbuild.",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --fixture",
    "test": "node --test \"tests/*.test.js\"",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs && cd dist && zip -rq ../copo-extension.zip . -x '*.DS_Store'"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
